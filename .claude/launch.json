{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "carmania-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true,
      "env": {
        "NEXT_BUILD_DIR": ".next-preview"
      }
    },
    {
      "name": "carmania-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000,
      "autoPort": true,
      "env": {
        "NEXT_BUILD_DIR": ".next-preview"
      }
    }
  ]
}
